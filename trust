.fg{position:absolute;inset:-32px;border-radius:50%;background:radial-gradient(circle,rgba(245,200,66,0.1) 0%,transparent 70%);pointer-events:none;}
.fc-nm{font-family:"Cinzel Decorative",cursive;font-size:.88rem;color:var(--gold);background:rgba(245,200,66,0.09);border:1px solid rgba(245,200,66,0.22);border-radius:3px;padding:7px 14px;display:inline-block;margin-bottom:6px;}
