<!DOCTYPE html>
<html lang="hi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>श्री पुत्तू लम्बरदार लोक कल्याण ट्रस्ट | अपनी गीता</title>
<link href="https://fonts.googleapis.com/css2?family=Cinzel+Decorative:wght@400;700;900&family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400;1,600&family=Noto+Serif+Devanagari:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
<style>
:root{
  --gold:#f5c842;--saffron:#ff7722;--dark-saffron:#d45500;
  --midnight:#060612;--navy:#0d0d30;--peacock:#1a6b8a;
  --cream:#fdf6e3;--card-bg:rgba(13,13,48,0.82);--border:rgba(245,200,66,0.22);
}
*{margin:0;padding:0;box-sizing:border-box;}
html{scroll-behavior:smooth;}
body{background:var(--midnight);color:var(--cream);font-family:"Noto Serif Devanagari",serif;overflow-x:hidden;line-height:1.9;font-size:17px;}
#bgc{position:fixed;inset:0;z-index:0;pointer-events:none;}
.orb{position:fixed;top:-200px;left:50%;transform:translateX(-50%);width:700px;height:700px;border-radius:50%;background:radial-gradient(circle,rgba(245,200,66,0.1) 0%,rgba(255,119,34,0.05) 40%,transparent 70%);pointer-events:none;z-index:0;animation:orbA 8s ease-in-out infinite;}
@keyframes orbA{0%,100%{opacity:.5;transform:translateX(-50%) scale(1);}50%{opacity:1;transform:translateX(-50%) scale(1.2);}}

/* TRICOLOR */
.tribar{position:relative;z-index:20;height:8px;background:linear-gradient(90deg,#ff9933 0%,#ff9933 33.3%,#fff 33.3%,#fff 66.6%,#138808 66.6%,#138808 100%);}

/* MODAL */
.modal-overlay{display:none;position:fixed;inset:0;background:rgba(0,0,0,0.85);z-index:999;align-items:center;justify-content:center;padding:20px;backdrop-filter:blur(10px);}
.modal-overlay.open{display:flex;animation:fadeIn .3s ease;}
@keyframes fadeIn{from{opacity:0;}to{opacity:1;}}
.modal-box{background:linear-gradient(135deg,#0d0d30,#080820);border:1px solid var(--border);border-radius:8px;max-width:700px;width:100%;max-height:88vh;overflow-y:auto;padding:44px 40px;position:relative;box-shadow:0 0 80px rgba(245,200,66,0.15);animation:slideUp .35s ease;}
@keyframes slideUp{from{opacity:0;transform:translateY(40px);}to{opacity:1;transform:translateY(0);}}
.modal-box::before{content:"";position:absolute;top:0;left:0;right:0;height:3px;background:linear-gradient(90deg,var(--saffron),var(--gold),var(--saffron));}
.modal-close{position:absolute;top:14px;right:18px;background:rgba(245,200,66,0.1);border:1px solid rgba(245,200,66,0.2);color:rgba(253,246,227,0.7);font-size:1.2rem;cursor:pointer;transition:.3s;line-height:1;width:32px;height:32px;border-radius:50%;display:flex;align-items:center;justify-content:center;}
.modal-close:hover{color:var(--gold);background:rgba(245,200,66,0.2);}
.modal-title{font-family:"Cinzel Decorative",cursive;font-size:1.2rem;color:var(--gold);margin-bottom:7px;padding-right:40px;}
.modal-sub{font-size:.78rem;color:var(--saffron);letter-spacing:4px;text-transform:uppercase;margin-bottom:22px;font-family:"Playfair Display",serif;}
.modal-body{font-size:.95rem;color:rgba(253,246,227,0.74);line-height:2;}
.modal-body strong{color:var(--gold);}
.modal-body em{color:var(--saffron);font-style:normal;}
.modal-body .shloka-big{font-size:1.15rem;color:#fff8dc;font-weight:700;line-height:2.2;margin:18px 0;padding:22px 26px;background:rgba(245,200,66,0.05);border-left:3px solid var(--gold);border-radius:0 4px 4px 0;}
.modal-body ul{list-style:none;margin:14px 0;}
.modal-body ul li{padding:8px 0;border-bottom:1px solid rgba(245,200,66,0.07);font-size:.92rem;}
.modal-body ul li::before{content:"✦ ";color:var(--saffron);}
.modal-img{width:100%;border-radius:6px;margin:16px 0;border:1px solid rgba(245,200,66,0.2);}

/* NAV */
#nav{position:sticky;top:0;z-index:200;background:rgba(6,6,18,0.97);backdrop-filter:blur(24px);border-bottom:1px solid var(--border);}
.nav-inner{max-width:1240px;margin:0 auto;display:flex;align-items:center;justify-content:space-between;padding:0 28px;height:66px;gap:12px;}
.nav-logo{font-family:"Cinzel Decorative",cursive;font-size:.9rem;color:var(--gold);text-decoration:none;letter-spacing:1px;line-height:1.3;cursor:pointer;}
.nav-logo span{color:var(--saffron);display:block;font-size:.65rem;letter-spacing:2px;}
.nav-links{display:flex;gap:2px;list-style:none;flex-wrap:wrap;}
.nav-links li a{color:rgba(253,246,227,0.62);text-decoration:none;font-size:.75rem;letter-spacing:1.5px;text-transform:uppercase;padding:7px 10px;border-radius:2px;transition:all .3s;font-family:"Playfair Display",serif;cursor:pointer;white-space:nowrap;display:block;}
.nav-links li a:hover,.nav-links li a.active{color:var(--gold);background:rgba(245,200,66,0.09);}

/* HERO */
#hero{position:relative;z-index:10;min-height:100vh;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;padding:90px 24px 60px;}
.hero-om{font-size:5.5rem;line-height:1;background:linear-gradient(180deg,#fff8dc,var(--gold),var(--saffron));-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;filter:drop-shadow(0 0 28px rgba(245,200,66,0.7));display:block;animation:floatY 5s ease-in-out infinite;margin-bottom:12px;}
@keyframes floatY{0%,100%{transform:translateY(0);}50%{transform:translateY(-13px);}}
.hero-tag{font-size:.82rem;letter-spacing:8px;text-transform:uppercase;color:var(--saffron);margin:10px 0;font-family:"Playfair Display",serif;font-style:italic;}
#hero h1{font-family:"Cinzel Decorative",cursive;font-size:clamp(1.5rem,4vw,3.2rem);font-weight:900;background:linear-gradient(135deg,#fff8dc 0%,var(--gold) 35%,var(--saffron) 65%,var(--gold) 100%);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;letter-spacing:2px;line-height:1.25;margin-bottom:10px;}
.hero-sub{font-size:1.1rem;color:rgba(253,246,227,0.62);margin:6px 0 8px;letter-spacing:4px;font-family:"Playfair Display",serif;font-style:italic;}
.hero-reg{display:inline-flex;align-items:center;gap:10px;background:rgba(19,136,8,0.1);border:1px solid rgba(19,136,8,0.38);border-radius:3px;padding:8px 20px;font-size:.8rem;color:#4caf72;letter-spacing:2px;margin-bottom:10px;font-family:"Playfair Display",serif;}
.hero-india{display:inline-block;background:rgba(245,200,66,0.08);border:1px solid rgba(245,200,66,0.25);border-radius:3px;padding:7px 18px;font-size:.78rem;color:var(--gold);letter-spacing:2px;margin-bottom:18px;font-family:"Playfair Display",serif;cursor:pointer;transition:.3s;}
.hero-india:hover{background:rgba(245,200,66,0.14);}
.hero-krishna{width:190px;height:250px;object-fit:cover;border-radius:8px;border:2px solid rgba(245,200,66,0.38);box-shadow:0 0 55px rgba(245,200,66,0.28),0 0 110px rgba(255,119,34,0.12);margin:16px auto;display:block;animation:kfloat 6s ease-in-out infinite;}
@keyframes kfloat{0%,100%{transform:translateY(0);}50%{transform:translateY(-10px);}}
.hero-desc{max-width:680px;font-size:1rem;line-height:2.1;color:rgba(253,246,227,0.7);margin:10px auto 20px;}
.hero-desc strong{color:var(--gold);}
.badges-row{display:flex;flex-wrap:wrap;gap:10px;justify-content:center;margin-bottom:22px;}
.badge{display:inline-flex;align-items:center;gap:8px;background:rgba(26,107,138,0.15);border:1px solid rgba(26,107,138,0.4);border-radius:4px;padding:9px 18px;font-size:.8rem;color:#6bc8e8;font-family:"Playfair Display",serif;cursor:pointer;transition:.3s;}
.badge:hover{background:rgba(26,107,138,0.25);border-color:rgba(107,200,232,0.5);}
.badge.gold{background:rgba(245,200,66,0.09);border-color:rgba(245,200,66,0.4);color:var(--gold);}
.cta-group{display:flex;gap:12px;flex-wrap:wrap;justify-content:center;}
.btn-p{background:linear-gradient(135deg,var(--saffron),var(--dark-saffron));color:#fff;border:none;padding:13px 28px;font-size:.92rem;font-family:"Noto Serif Devanagari",serif;cursor:pointer;border-radius:2px;text-decoration:none;transition:all .3s;box-shadow:0 4px 20px rgba(255,119,34,0.3);display:inline-block;}
.btn-p:hover{transform:translateY(-3px);box-shadow:0 8px 28px rgba(255,119,34,0.5);}
.btn-o{background:transparent;color:var(--gold);border:1px solid rgba(245,200,66,0.48);padding:13px 28px;font-size:.92rem;font-family:"Noto Serif Devanagari",serif;cursor:pointer;border-radius:2px;text-decoration:none;transition:all .3s;display:inline-block;}
.btn-o:hover{background:rgba(245,200,66,0.09);transform:translateY(-3px);}

/* STATS */
.stats-band{position:relative;z-index:10;background:linear-gradient(90deg,rgba(26,107,138,0.09),rgba(245,200,66,0.07),rgba(26,107,138,0.09));border-top:1px solid var(--border);border-bottom:1px solid var(--border);padding:42px 24px;}
.stats-inner{max-width:1050px;margin:0 auto;display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:14px;}
.stat-box{text-align:center;padding:20px 12px;cursor:pointer;transition:.3s;border-radius:4px;border:1px solid transparent;}
.stat-box:hover{background:rgba(245,200,66,0.06);border-color:rgba(245,200,66,0.15);}
.stat-num{font-family:"Cinzel Decorative",cursive;font-size:2.2rem;color:var(--gold);display:block;line-height:1;}
.stat-label{font-size:.77rem;color:rgba(253,246,227,0.5);letter-spacing:2.5px;text-transform:uppercase;margin-top:7px;font-family:"Playfair Display",serif;}

/* SECTION */
.sw{position:relative;z-index:10;padding:80px 24px;max-width:1120px;margin:0 auto;}
.sl{font-family:"Playfair Display",serif;font-size:.76rem;letter-spacing:7px;text-transform:uppercase;color:var(--saffron);margin-bottom:12px;display:block;}
.st{font-family:"Cinzel Decorative",cursive;font-size:clamp(1.25rem,2.6vw,2rem);color:var(--gold);margin-bottom:14px;position:relative;display:inline-block;}
.st::after{content:"";display:block;height:2px;width:50%;margin-top:8px;background:linear-gradient(90deg,var(--saffron),transparent);}
.si{font-size:1rem;color:rgba(253,246,227,0.65);max-width:680px;line-height:2;margin-bottom:42px;}

/* BANDS */
.band{position:relative;z-index:10;padding:60px 24px;}
.band-s{background:linear-gradient(90deg,rgba(255,119,34,0.06),rgba(245,200,66,0.1),rgba(255,119,34,0.06));border-top:1px solid rgba(245,200,66,0.12);border-bottom:1px solid rgba(245,200,66,0.12);}
.band-p{background:linear-gradient(90deg,rgba(26,107,138,0.07),rgba(26,107,138,0.13),rgba(26,107,138,0.07));border-top:1px solid rgba(26,107,138,0.2);border-bottom:1px solid rgba(26,107,138,0.2);}

/* SHLOKA */
.shloka-hero{background:linear-gradient(135deg,rgba(26,107,138,0.11),rgba(245,200,66,0.06));border:1px solid rgba(245,200,66,0.28);border-radius:6px;padding:52px 42px;text-align:center;cursor:pointer;transition:.3s;}
.shloka-hero:hover{border-color:rgba(245,200,66,0.45);box-shadow:0 0 40px rgba(245,200,66,0.1);}
.sh-s{font-size:clamp(1.15rem,2.6vw,1.6rem);line-height:2.2;color:#fff8dc;font-weight:700;margin-bottom:24px;text-shadow:0 0 28px rgba(245,200,66,0.35);}
.sh-d{width:80px;height:1px;background:linear-gradient(90deg,transparent,var(--gold),transparent);margin:0 auto 24px;}
.sh-m{font-size:1.08rem;line-height:2;color:rgba(253,246,227,0.78);font-style:italic;font-family:"Playfair Display",serif;max-width:600px;margin:0 auto;}
.sh-r{display:inline-block;margin-top:22px;font-size:.78rem;letter-spacing:5px;color:var(--saffron);text-transform:uppercase;}

/* CARDS */
.grid2{display:grid;grid-template-columns:1fr 1fr;gap:22px;}
.tcard{background:var(--card-bg);border:1px solid var(--border);border-radius:5px;padding:28px 26px;transition:all .4s;cursor:pointer;}
.tcard:hover{border-color:rgba(245,200,66,0.45);transform:translateY(-3px);box-shadow:0 12px 32px rgba(0,0,0,0.4);}
.tcard h3{font-family:"Cinzel Decorative",cursive;font-size:.9rem;color:var(--gold);margin-bottom:14px;}
.trow{display:flex;gap:12px;align-items:flex-start;margin-bottom:11px;font-size:.9rem;}
.tkey{color:var(--saffron);min-width:130px;flex-shrink:0;font-weight:600;font-size:.86rem;}
.tval{color:rgba(253,246,227,0.75);}

/* BANK */
.bank-c{background:linear-gradient(135deg,rgba(19,136,8,0.14),rgba(13,13,48,0.9));border:1px solid rgba(19,136,8,0.38);border-radius:6px;padding:34px 28px;text-align:center;cursor:pointer;transition:.3s;}
.bank-c:hover{border-color:rgba(19,136,8,0.6);box-shadow:0 0 30px rgba(19,136,8,0.1);}
.bank-c h3{font-family:"Cinzel Decorative",cursive;font-size:.95rem;color:#4caf72;margin-bottom:22px;}
.bank-row{display:flex;justify-content:space-between;align-items:center;padding:10px 0;border-bottom:1px solid rgba(255,255,255,0.05);font-size:.9rem;}
.bank-row:last-child{border:none;}
.bk{color:rgba(253,246,227,0.5);}
.bv{color:#fff8dc;font-weight:700;font-family:"Cinzel Decorative",cursive;font-size:.86rem;letter-spacing:1px;}

/* PILLARS */
.pgrid{display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:20px;}
.pillar{background:var(--card-bg);border:1px solid var(--border);border-radius:4px;padding:30px 24px;transition:all .4s;cursor:pointer;position:relative;overflow:hidden;}
.pillar::before{content:"";position:absolute;top:0;left:0;right:0;height:3px;background:linear-gradient(90deg,var(--saffron),var(--gold));transform:scaleX(0);transform-origin:left;transition:.4s;}
.pillar:hover{border-color:rgba(245,200,66,0.48);transform:translateY(-5px);}
.pillar:hover::before{transform:scaleX(1);}
.pi{font-size:2.4rem;margin-bottom:14px;display:block;}
.pn{font-family:"Cinzel Decorative",cursive;font-size:.88rem;color:var(--gold);margin-bottom:9px;}
.pd{font-size:.88rem;color:rgba(253,246,227,0.6);line-height:1.85;}

/* UDDESHYA */
.ugrid{display:grid;grid-template-columns:repeat(auto-fit,minmax(290px,1fr));gap:16px;}
.ud{background:var(--card-bg);border:1px solid var(--border);border-radius:4px;padding:20px 18px;transition:all .35s;display:flex;gap:14px;align-items:flex-start;cursor:pointer;}
.ud:hover{border-color:rgba(245,200,66,0.38);transform:translateY(-3px);box-shadow:0 10px 26px rgba(0,0,0,0.35);}
.udn{font-family:"Cinzel Decorative",cursive;font-size:.72rem;color:var(--saffron);min-width:32px;background:rgba(255,119,34,0.1);border:1px solid rgba(255,119,34,0.22);border-radius:3px;padding:4px 5px;text-align:center;margin-top:3px;flex-shrink:0;}
.udt{font-size:.9rem;color:rgba(253,246,227,0.72);line-height:1.85;}

/* SHLOKAS */
.sgrid{display:grid;grid-template-columns:repeat(auto-fit,minmax(275px,1fr));gap:20px;}
.sc{background:var(--card-bg);border:1px solid var(--border);border-radius:4px;padding:28px 24px;transition:all .4s;cursor:pointer;}
.sc:hover{border-color:rgba(245,200,66,0.45);transform:translateY(-4px);box-shadow:0 15px 38px rgba(0,0,0,0.4);}
.sc-ch{font-size:.73rem;letter-spacing:4px;color:var(--saffron);margin-bottom:13px;font-family:"Playfair Display",serif;}
.sc-s{font-size:1.02rem;line-height:2;color:#fff8dc;font-weight:600;margin-bottom:13px;}
.sc-m{font-size:.9rem;color:rgba(253,246,227,0.58);line-height:1.8;font-style:italic;font-family:"Playfair Display",serif;}

/* BLOG */
.blog-c{background:var(--card-bg);border:1px solid var(--border);border-radius:6px;padding:44px 40px;position:relative;overflow:hidden;}
.blog-c::after{content:"";position:absolute;bottom:0;left:0;right:0;height:3px;background:linear-gradient(90deg,var(--peacock),var(--gold),var(--saffron));}
.blog-h{font-family:"Cinzel Decorative",cursive;font-size:clamp(1rem,2.4vw,1.5rem);color:var(--gold);margin-bottom:24px;line-height:1.5;}
.bpt{display:flex;gap:16px;align-items:flex-start;margin-bottom:22px;padding:20px 22px;background:rgba(245,200,66,0.03);border-left:2px solid rgba(245,200,66,0.28);border-radius:0 4px 4px 0;transition:.3s;cursor:pointer;}
.bpt:hover{border-left-color:var(--saffron);background:rgba(245,200,66,0.05);}
.bpi{font-size:1.7rem;flex-shrink:0;margin-top:4px;}
.bpc h4{font-size:.97rem;color:var(--gold);margin-bottom:5px;}
.bpc p{font-size:.9rem;color:rgba(253,246,227,0.65);line-height:1.9;}
.vichar{background:linear-gradient(135deg,rgba(255,119,34,0.1),rgba(245,200,66,0.06));border:1px solid rgba(245,200,66,0.22);border-radius:4px;padding:26px 30px;margin-top:28px;text-align:center;}
.vichar .vl{font-size:.73rem;letter-spacing:6px;color:var(--saffron);text-transform:uppercase;margin-bottom:13px;display:block;font-family:"Playfair Display",serif;}
.vichar p{font-size:1.1rem;font-style:italic;color:#fff8dc;font-family:"Playfair Display",serif;line-height:2;}

/* MAHANUBHAV - BLESSINGS */
.bless-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:22px;}
.bless-card{background:var(--card-bg);border:1px solid var(--border);border-radius:6px;overflow:hidden;transition:all .4s;cursor:pointer;}
.bless-card:hover{border-color:rgba(245,200,66,0.45);transform:translateY(-5px);box-shadow:0 18px 45px rgba(0,0,0,0.45);}
.bless-img-wrap{position:relative;height:220px;overflow:hidden;}
.bless-img-wrap img{width:100%;height:100%;object-fit:cover;object-position:top;transition:transform .5s;}
.bless-card:hover .bless-img-wrap img{transform:scale(1.05);}
.bless-num{position:absolute;top:12px;left:12px;background:linear-gradient(135deg,var(--saffron),var(--dark-saffron));color:#fff;font-family:"Cinzel Decorative",cursive;font-size:.72rem;padding:5px 12px;border-radius:2px;letter-spacing:2px;}
.bless-body{padding:22px 20px;}
.bless-name{font-family:"Cinzel Decorative",cursive;font-size:.92rem;color:var(--gold);margin-bottom:5px;}
.bless-role{font-size:.76rem;color:var(--saffron);letter-spacing:2px;text-transform:uppercase;margin-bottom:12px;font-family:"Playfair Display",serif;}
.bless-text{font-size:.88rem;color:rgba(253,246,227,0.65);line-height:1.85;}

/* GALLERY */
.gallery-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:18px;}
.gal-item{border-radius:6px;overflow:hidden;border:1px solid var(--border);cursor:pointer;transition:all .4s;position:relative;}
.gal-item:hover{border-color:rgba(245,200,66,0.45);transform:scale(1.02);box-shadow:0 16px 40px rgba(0,0,0,0.5);}
.gal-item img{width:100%;height:240px;object-fit:cover;display:block;transition:transform .5s;}
.gal-item:hover img{transform:scale(1.08);}
.gal-caption{position:absolute;bottom:0;left:0;right:0;background:linear-gradient(transparent,rgba(6,6,18,0.9));padding:20px 16px 14px;font-size:.82rem;color:rgba(253,246,227,0.8);font-family:"Playfair Display",serif;}

/* FAQ */
.faq-layout{display:grid;grid-template-columns:250px 1fr;gap:50px;align-items:start;}
.faq-img{width:100%;border-radius:8px;border:2px solid rgba(245,200,66,0.28);box-shadow:0 0 44px rgba(245,200,66,0.18);display:block;}
.faq-list{display:flex;flex-direction:column;gap:13px;}
.faq-item{background:var(--card-bg);border:1px solid var(--border);border-radius:4px;overflow:hidden;transition:.3s;}
.faq-item:hover{border-color:rgba(245,200,66,0.38);}
.faq-q{width:100%;background:none;border:none;color:var(--cream);font-family:"Noto Serif Devanagari",serif;font-size:.95rem;font-weight:600;text-align:left;padding:18px 22px;cursor:pointer;display:flex;justify-content:space-between;align-items:center;gap:12px;transition:.3s;line-height:1.5;}
.faq-q:hover{color:var(--gold);}
.arrow{color:var(--saffron);transition:.3s;flex-shrink:0;}
.faq-q.open .arrow{transform:rotate(180deg);}
.faq-a{max-height:0;overflow:hidden;transition:max-height .45s ease;}
.faq-a.open{max-height:400px;padding:0 22px 20px;}
.faq-a p{font-size:.9rem;color:rgba(253,246,227,0.66);line-height:1.9;border-left:2px solid rgba(245,200,66,0.32);padding-left:16px;}
.faq-a .gr{display:block;font-size:.73rem;color:var(--saffron);letter-spacing:3px;margin-top:9px;font-family:"Playfair Display",serif;}

/* TRUSTEES */
.tgrid{display:grid;grid-template-columns:1fr 1fr;gap:16px;}
.tr{background:var(--card-bg);border:1px solid var(--border);border-radius:4px;padding:18px 20px;display:flex;gap:14px;align-items:center;transition:.35s;cursor:pointer;}
